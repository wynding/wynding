{
  "name": "@wynding/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Capacitor Host that packages the Wynding Host build (iOS / iPadOS / Android).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint capacitor.config.ts",
    "sync:ios": "pnpm --filter @wynding/web run build:host && cap sync ios",
    "sync:android": "pnpm --filter @wynding/web run build:host && cap sync android",
    "sync:all": "pnpm --filter @wynding/web run build:host && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "assets:ios": "pnpm --filter @wynding/web run gen:icons && capacitor-assets generate --ios --assetPath ../web/assets/native",
    "assets:android": "pnpm --filter @wynding/web run gen:icons && capacitor-assets generate --android --assetPath ../web/assets/native"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0"
  }
}
