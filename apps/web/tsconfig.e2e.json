{
  // The Playwright specs get a REAL typecheck (#110) — but in their own program, so the
  // `declare global { interface Window { … } }` blocks in `e2e/*-stub.ts` augment only this
  // program and stay invisible to `apps/web/src/**`. See the `e2e` paragraph in
  // `tsconfig.json` for why that reverse edge is worth this second file.
  //
  // `extends` supplies the shared configuration; `files`, `include` and `exclude` are the
  // fields a child REPLACES rather than merges, so the `include` below fully supersedes the
  // base's rather than adding to it — which is exactly what is wanted here, and the specs'
  // own imports (`../src/layout`) pull in what they need. Run by `pnpm -C apps/web typecheck`
  // as a second `tsc --noEmit -p`, so a broken spec fails `verify` exactly as loudly as
  // broken app code.
  "extends": "./tsconfig.json",
  "include": ["e2e"]
}
