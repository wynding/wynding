{
  // `noEmit` (#109): esbuild builds this package now — `dist/handler.js` is a single
  // self-contained bundle, and `dist/rulesets/` is staged beside it. `tsc` is the TYPE
  // CHECKER here and nothing else; left emitting, it would scatter per-module `.js` into
  // the same `dist/` the bundle owns, where a stale file can shadow what actually ships.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/sim" },
    { "path": "../../packages/replay" },
    { "path": "../../packages/content" }
  ]
}
