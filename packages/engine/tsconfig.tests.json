{
  // The test files `tsconfig.base.json` excludes from the EMITTING program, type-checked
  // here in a second, check-only one — the same idiom `apps/web/tsconfig.e2e.json` uses.
  // `exclude` is REPLACED, not merged, by a child config, so `[]` restores the full `src`
  // program; `noEmit` keeps it out of `dist/`, which is the whole point of the exclude.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": []
}
