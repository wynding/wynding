{
  "name": "@wynding/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Board and wave data.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./artifact": "./src/artifact.ts",
    "./stress": "./src/stress.ts",
    "./catalog": "./src/catalog.ts"
  },
  "scripts": {
    "build": "tsc -b && mkdir -p dist/rulesets && cp src/rulesets/*.json dist/rulesets/",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@wynding/types": "workspace:*",
    "@wynding/sim": "workspace:*"
  }
}
