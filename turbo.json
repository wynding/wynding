{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", "eslint-rules/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-host/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "@wynding/perf#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../docs/adr/0005-performance-budgets.md",
        "../../docs/design-notes/performance-spike.md",
        "../../docs/milestones/m2.md"
      ]
    },
    "clean": {
      "cache": false
    },
    "@wynding/web#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@wynding/server#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@wynding/mobile#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
